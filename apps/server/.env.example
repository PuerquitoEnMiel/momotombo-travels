# Server environment example
# Copy to .env and fill in real values. Never commit .env to git.

# --- Runtime ---
NODE_ENV=development
PORT=3001

# --- Database ---
DATABASE_URL=postgresql://momotombo:password123@localhost:5432/momotombo_travels

# --- Security ---
# Generate with: openssl rand -base64 48
JWT_SECRET=replace-with-a-very-long-random-secret-min-32-chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# --- CORS / Client ---
CLIENT_URL=http://localhost:3000
# Comma-separated list of allowed origins
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# --- Google OAuth ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3001/auth/google/callback

# --- Stripe (payments) ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# --- AI / Vector search ---
GOOGLE_CLOUD_PROJECT=
GEMINI_API_KEY=
PINECONE_API_KEY=

# --- Uploads ---
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE_MB=5

# --- Rate limiting ---
THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=20
